<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that doesn't draw a window: the chat engine (Claude Code), the MCP server, the Plaxis link and tools,
       settings and updates. Plain net8.0 so it builds and its tests run on any machine. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PlaxisProMax</RootNamespace>
    <AssemblyName>PlaxisProMax.Core</AssemblyName>
    <Version>0.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The worker runs on Plaxis's own Python; it ships next to the program. -->
    <None Include="Plaxis\plaxis_worker.py" CopyToOutputDirectory="PreserveNewest" Link="plaxis_worker.py" />
    <None Include="Plaxis\ppm_build.py" CopyToOutputDirectory="PreserveNewest" Link="ppm_build.py" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Chat\chat-prompts.json" LogicalName="PlaxisProMax.chat-prompts.json" />
    <!-- The Modeller and Viewer pages, their builder script and the sample models: inside the program, so nothing can go missing. -->
    <EmbeddedResource Include="Modeller\web\*.*" LogicalName="PlaxisProMax.web.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Modeller\samples\*.ppm" LogicalName="PlaxisProMax.sample.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Plaxis\ppm_build.py" LogicalName="PlaxisProMax.ppm_build.py" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlaxisProMax" />
    <InternalsVisibleTo Include="PlaxisProMax.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.35" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>
</Project>
